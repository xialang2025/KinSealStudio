<RCC>
    <qresource prefix="/native">
        <!-- 20261109-0 add: Parsed metadata seed for typed bit-button source generation. -->
        <file alias="bit-button-default.sm">resources/native-bit-button-default.sm</file>
        <!-- 20261109-6 add: A true UI-created word source supplies its typed subtype metadata. -->
        <file alias="word-button-default.sm">resources/native-word-button-default.sm</file>
        <!-- 20261109-8 add: Real subtype4 source metadata, retained independently of operation buttons. -->
        <file alias="lamp-default.sm">resources/native-lamp-default.sm</file>
        <!-- 20261110-0 add: True UI-created subtype-three source metadata for address-free system functions. -->
        <file alias="function-button-default.sm">resources/native-function-button-default.sm</file>
    </qresource>
    <qresource prefix="/samples">
        <file alias="native_text.sm">samples/native-device-test/CodexProbeText4.sm</file>
    </qresource>
    <qresource prefix="/download">
        <!-- 20261108-10 add: Immutable TEST-only device payload. -->
        <file alias="SysPara.dat">samples/native-device-test/compile-test/SysPara.dat</file>
        <file alias="SheetPara.dat">samples/native-device-test/compile-test/SheetPara.dat</file>
        <file alias="AlarmPara.dat">samples/native-device-test/compile-test/AlarmPara.dat</file>
        <file alias="Collect.dat">samples/native-device-test/compile-test/Collect.dat</file>
        <file alias="AddrPara.dat">samples/native-device-test/compile-test/AddrPara.dat</file>
        <file alias="PicLenPara.dat">samples/native-device-test/compile-test/PicLenPara.dat</file>
        <file alias="Curve.dat">samples/native-device-test/compile-test/Curve.dat</file>
        <file alias="upLoad.knr">samples/native-device-test/compile-test/upLoad.knr</file>
        <file alias="SheetPixel.dat">samples/native-device-test/compile-test/SheetPixel.dat</file>
        <file alias="Modbus_RTU_com1.bin">samples/native-device-test/compile-test/Modbus_RTU_com1.bin</file>
    </qresource>
</RCC>
