    "class": "SimulationModbusTransport",
    "connect": "connectToStation(int station, const SimulationModbusIo&, options, error)",
    "enqueue": "enqueue(const SimulationModbusRequest&, error)",
    "executeOne": "processNext() returns SimulationModbusResult synchronously",
    "exit": "disconnectFromStation(); destructor also clears unsent queue and closes at most once",
    "inspect": [
      "isConnected",
      "pendingCount",
      "firstError"
    ],
    "frameBuilder": "buildSimulationModbusRequest(station, request, frame, error)",
    "json": "simulationModbusResultToJson(result)",
    "io": {
      "open": "bool(QString*); failed open cleans any resources acquired by callback",
      "write": "int(const QByteArray&, int timeoutMs); exactly one call, exact byte-count required",
      "read": "SimulationModbusReadChunk(int maxBytes, int timeoutMs)",
      "close": "bool(QString*); cleanup failure does not mask the first transaction error"
    },
    "readChunk": {
      "bytes": "One partial frame chunk, no more than maxBytes",
      "endOfFrame": "Explicit observed replay boundary; future serial caller must supply RTU silent-gap framing",
      "timedOut": "Deadline exhausted, even if partial bytes accompany it",
      "error": "Nonempty callback error disconnects immediately"
    }
  },
  "contract": {
    "station": "explicit unicast 1..247; 0 broadcast and 248..255 rejected before open",
    "address": "zero-based PDU offset 0..65535; address+count cannot exceed 65536",
    "readCoils01": "1..2000 bits; least-significant-bit first; unused high bits must be zero",
    "readHolding03": "1..125 unsigned 16-bit words; network byte order",
    "writeCoil05": "exactly one; public logical 0/1 encodes 0000/ff00",
    "writeRegister06": "exactly one unsigned 16-bit value",
    "crc": "CRC16 reflected polynomial a001, initial ffff, low byte first",
    "queue": "1..1024 configurable bound; default32; duplicate pending request ids rejected; owned snapshots",
    "timeout": "1..60000ms configurable whole-transaction deadline, default1000; includes write callback",
    "callbackDiscipline": "single owner; callbacks must obey provided deadlines and not throw; disconnect is deferred until active callback returns",
    "readBound": "maximum response255 bytes; accumulator ceiling257 detects trailing response data",
    "validation": "exact station/function/byte-count/total-length/CRC/coil padding; write echo must match full request",
    "exceptions": "01,02,03,04,05,06,08,0a,0b recognized as failure; 00/07/09/unassigned rejected",
    "publication": "only complete validated frame publishes all values or writeAcknowledged",
    "onFailure": "disconnect, clear all unsent queued work, preserve first error, no automatic retry",
    "unknownRemoteState": "any failed attempted write sets remoteStateUnconfirmed; no rollback or nonexecution promise"
  },
