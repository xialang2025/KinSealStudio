        BEGIN
            VALUE "FileDescription", "KinSealStudio Lite - Restricted Validation Release\0"
            VALUE "FileVersion", "0.11.0\0"
            VALUE "InternalName", "KinSealStudioLite\0"
            VALUE "OriginalFilename", "KinSealStudioLite.exe\0"
            VALUE "ProductName", "KinSealStudio Lite\0"
            VALUE "ProductVersion", "0.11.0\0"
        END
    END
    BLOCK "VarFileInfo"
